// The whole site: one long page - hero, work, writing, about, contact.

struct Project {
    name:s,
    role:s,
    href:s,
    link_label:s,
    summary:s,
    detail:s,
    tags:s
}

struct WritingItem {
    title:s,
    kind:s,
    status:s,
    blurb:s
}

f projects():a:Project {
    r [
        Project {
            name = `Houski`,
            role = `Co-founder and CEO`,
            href = `https://houski.ca`,
            link_label = `houski.ca`,
            summary = `A property data platform for Canada and the United States.`,
            detail = `Houski takes the scattered, inconsistent public record - assessments, listings, addresses, geography - and turns it into one clean, queryable dataset that developers and analysts can actually build on. The pipeline is Rust end to end: importers that normalise every source into a common shape, an address standardiser that reconciles the same property described five different ways, and an API that serves the result. I co-founded it, run it, and still write a good deal of the code.`,
            tags = `Rust, Polars, Data pipelines, API design, Real estate`
        },
        Project {
            name = `Simple Universal Language`,
            role = `Creator`,
            href = `https://sul.alex-wilkinson.ca`,
            link_label = `sul.alex-wilkinson.ca`,
            summary = `An auxiliary language designed to be the easiest one on Earth to learn.`,
            detail = `Twelve letters, one sound per letter, and no irregular verbs, gendered nouns, silent letters or spelling exceptions anywhere in the grammar. Small roots snap together into larger words, so a handful of them already gets you thousands of meanings. Braille and sign language are part of the original design rather than translations bolted on afterwards - the braille dots sit directly on the printed strokes, so one printing reads by sight or by touch. The site itself is written in Nail, and the dictionary is live.`,
            tags = `Language design, Nail, Typography, Accessibility, Braille`
        },
        Project {
            name = `Nail`,
            role = `Creator`,
            href = `https://nail.alex-wilkinson.ca`,
            link_label = `nail.alex-wilkinson.ca`,
            summary = `A programming language for grug-brain developers that transpiles to Rust.`,
            detail = `Nail is an experiment in taking things away. No mutability, no null, no classes, no generics, no macros, no package manager, no imports - and no hidden control flow either: its collection operations are spelled out as map, filter, reduce and scan rather than hidden behind method chains. What it compiles to is ordinary async Rust, so the result is genuinely fast rather than merely simple. The compiler is written in Rust, and this page you are reading is served by a Nail program.`,
            tags = `Rust, Compilers, Transpilers, Type systems, Language design`
        }
    ];
}

f writing_items():a:WritingItem {
    r [
        WritingItem {
            title = `A book on simplicity`,
            kind = `Non-fiction`,
            status = `In progress`,
            blurb = `The thread running through everything else on this page: why systems - languages, software, companies, institutions - accumulate complexity, what that complexity costs the people using them, and what it takes to remove it rather than paper over it.`
        },
        WritingItem {
            title = `A novel`,
            kind = `Fiction`,
            status = `In progress`,
            blurb = `A work of fiction, written slowly and in the gaps. More about it here once there is something worth reading.`
        }
    ];
}

f hero_html():s {
    r array_join([
        `<section class="relative overflow-hidden border-b `, border_soft(), `">`,
        // A very faint dot field, fading out downward, so the hero has some
        // texture without anything competing with the type.
        `<div aria-hidden="true" class="pointer-events-none absolute inset-0 [background-image:radial-gradient(circle_at_1px_1px,rgb(161_161_170/0.35)_1px,transparent_0)] [background-size:22px_22px] [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>`,
        `<div class="relative `, container(), ` py-20 sm:py-28">`,
        section_label(`Alex Wilkinson`),
        `<h1 class="mt-6 max-w-3xl text-4xl font-bold tracking-tight sm:text-6xl `, text_strong(), `">`,
        `I build things that make complicated systems `,
        `<span class="`, text_accent(), `">simple</span>.</h1>`,
        `<p class="mt-6 max-w-2xl text-lg leading-relaxed sm:text-xl `, text_body(), `">`,
        `Co-founder and CEO of <a href="https://houski.ca" class="font-medium underline decoration-emerald-500/60 underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-50">Houski</a>, `,
        `where we turn the mess of North American property records into one clean dataset. In the hours around that I design programming languages, `,
        `a universal language anyone can learn, and write about why simplicity is so hard to hold onto.</p>`,
        `<div class="mt-10 flex flex-wrap gap-3">`,
        link_button(`#work`, button_solid(), ``, `See the work`),
        link_button(github_url(), button_outline(), ``, `GitHub`),
        link_button(`#contact`, button_outline(), ``, `Get in touch`),
        `</div>`,
        `</div>`,
        `</section>`
    ], ``);
}

f project_card(project:Project, number:i):s {
    padded:s = string_pad_start(string_from(number), 2, `0`);
    r array_join([
        `<article class="group relative rounded-2xl border p-6 transition sm:p-8 `, border_soft(), ` `, surface_card(),
        ` hover:border-emerald-500/50 hover:shadow-lg hover:shadow-emerald-500/5">`,
        `<div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">`,
        `<span class="font-mono text-sm `, text_muted(), `">`, padded, `</span>`,
        `<h3 class="text-2xl font-bold tracking-tight `, text_strong(), `">`, project.name, `</h3>`,
        `<span class="font-mono text-xs uppercase tracking-[0.15em] `, text_accent(), `">`, project.role, `</span>`,
        `</div>`,
        `<p class="mt-3 text-lg font-medium `, text_strong(), `">`, project.summary, `</p>`,
        `<p class="mt-4 max-w-3xl leading-relaxed `, text_body(), `">`, project.detail, `</p>`,
        tag_pills(project.tags),
        `<a href="`, project.href, `" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold `, text_accent(),
        ` underline decoration-emerald-500/40 underline-offset-4 transition hover:decoration-emerald-500">`,
        project.link_label,
        icon_arrow(`h-4 w-4 transition group-hover:translate-x-0.5`),
        `</a>`,
        `</article>`
    ], ``);
}

f work_html():s {
    items:a:Project = projects();
    positions:a:i = array_range_inclusive(1, array_length(items));
    cards:a:s = map position in positions {
        project:Project = danger(array_get(items, position - 1));
        y project_card(project, position);
    };

    r array_join([
        `<section class="`, container(), ` py-20 sm:py-28">`,
        section_heading(`work`, `Work`, `Three things I have built`,
            `One is a company, one is a language people speak, one is a language computers speak. They are more alike than they sound.`),
        `<div class="mt-12 flex flex-col gap-6">`, array_join(cards, ``), `</div>`,
        `</section>`
    ], ``);
}

f writing_card(item:WritingItem):s {
    r array_join([
        `<article class="rounded-2xl border border-dashed p-6 sm:p-8 `, border_soft(), `">`,
        `<div class="flex flex-wrap items-center gap-3">`,
        `<h3 class="text-xl font-bold tracking-tight `, text_strong(), `">`, item.title, `</h3>`,
        `<span class="rounded-full bg-emerald-500/10 px-3 py-1 font-mono text-xs `, text_accent(), `">`, item.status, `</span>`,
        `</div>`,
        `<p class="mt-1 font-mono text-xs uppercase tracking-[0.15em] `, text_muted(), `">`, item.kind, `</p>`,
        `<p class="mt-4 max-w-3xl leading-relaxed `, text_body(), `">`, item.blurb, `</p>`,
        `</article>`
    ], ``);
}

f writing_html():s {
    cards:a:s = map item in writing_items() {
        y writing_card(item);
    };

    r array_join([
        `<section class="border-y `, border_soft(), ` bg-zinc-50 dark:bg-zinc-900/40">`,
        `<div class="`, container(), ` py-20 sm:py-28">`,
        section_heading(`writing`, `Writing`, `Two books, both unfinished`,
            `Neither is out yet. When they are, they will be here first.`),
        `<div class="mt-12 grid gap-6 md:grid-cols-2">`, array_join(cards, ``), `</div>`,
        `</div>`,
        `</section>`
    ], ``);
}

f about_html():s {
    r array_join([
        `<section class="`, container(), ` py-20 sm:py-28">`,
        section_heading(`about`, `About`, `The short version`,
            `I like removing things.`),
        `<div class="mt-10 max-w-3xl space-y-5 text-lg leading-relaxed `, text_body(), `">`,
        `<p>Most of my work starts the same way: something that should be straightforward is not, and the reason turns out to be accumulated history rather than any real difficulty. Property records are a mess because a hundred jurisdictions each solved the same problem differently. Programming languages are hard because every one of them kept its old ideas while adding new ones. Natural languages are hard because nobody designed them at all.</p>`,
        `<p>So I build the version with the history taken out. Houski is that idea applied to real estate data, Nail to programming languages, and Simple Universal Language to human ones. Rust is what I reach for when the result has to be fast as well as simple.</p>`,
        `<p>I am based in Calgary, Canada. Nearly everything I make ends up open source.</p>`,
        `</div>`,
        `</section>`
    ], ``);
}

// The address is not in this HTML at all - it is assembled from character
// codes in static/js/site.js, and only after a deliberate two-second press.
// A scraper would have to run the page and hold a button down to get it.
f contact_html():s {
    r array_join([
        `<section class="border-t `, border_soft(), ` bg-zinc-50 dark:bg-zinc-900/40">`,
        `<div class="`, container(), ` py-20 sm:py-28">`,
        section_heading(`contact`, `Contact`, `Say hello`,
            `Press and hold the button for two seconds and my email address will appear. It is not written anywhere in this page - it is built in your browser, on purpose.`),
        `<div class="mt-10 max-w-md">`,
        `<button id="email-hold" type="button" `,
        `class="relative w-full select-none overflow-hidden rounded-xl border px-5 py-4 text-center text-sm font-semibold transition `,
        border_soft(), ` `, surface_card(), ` `, text_strong(),
        ` hover:border-emerald-500/60 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-600">`,
        `<span id="email-fill" class="absolute inset-y-0 left-0 w-0 bg-emerald-500/15"></span>`,
        `<span id="email-label" class="relative">Hold to reveal my email</span>`,
        `</button>`,
        // `hidden` and `flex` are both here on purpose: Tailwind emits `hidden`
        // last, so it wins until site.js removes it and the flex row appears.
        `<div id="email-result" class="hidden flex items-center justify-between gap-4 rounded-xl border p-4 `, border_soft(), ` `, surface_card(), `">`,
        `<a id="email-link" href="#" class="break-all font-mono text-sm font-semibold `, text_accent(),
        ` underline decoration-emerald-500/40 underline-offset-4"></a>`,
        `<button id="email-copy" type="button" class="shrink-0 rounded-lg border px-3 py-1.5 text-xs font-semibold transition `,
        border_soft(), ` `, text_body(), ` hover:text-zinc-900 dark:hover:text-zinc-50">`,
        `<span id="email-copy-state">Copy</span></button>`,
        `</div>`,
        `<p class="mt-4 text-sm `, text_muted(), `">Or find me on `,
        `<a href="`, github_url(), `" rel="me noopener" class="font-medium underline decoration-emerald-500/40 underline-offset-4 hover:text-zinc-900 dark:hover:text-zinc-50">GitHub</a>.</p>`,
        `</div>`,
        `</div>`,
        `</section>`
    ], ``);
}

f home_page():s {
    content:s = array_join([
        hero_html(),
        work_html(),
        writing_html(),
        about_html(),
        contact_html()
    ], ``);

    r layout(
        `Alex Wilkinson - Houski, Nail, and Simple Universal Language`,
        `Alex Wilkinson: co-founder and CEO of Houski, creator of the Nail programming language and Simple Universal Language.`,
        content
    );
}

f not_found_page():s {
    content:s = array_join([
        `<section class="`, container(), ` py-32 text-center">`,
        `<p class="font-mono text-sm `, text_accent(), `">404</p>`,
        `<h1 class="mt-4 text-4xl font-bold tracking-tight `, text_strong(), `">There is nothing here</h1>`,
        `<p class="mt-4 `, text_body(), `">This site is a single page, so it is almost certainly back at the start.</p>`,
        `<div class="mt-8 flex justify-center">`,
        link_button(`/`, button_solid(), ``, `Go home`),
        `</div>`,
        `</section>`
    ], ``);

    r layout(`Not found - Alex Wilkinson`, `Page not found.`, content);
}
